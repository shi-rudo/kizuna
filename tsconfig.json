{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["esnext", "dom"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
